menu = {"pizza":20,
         "nachos":30,
         "popcorn":25,
         "fries":50,
         "chips":10} 

cart = []
total = 0

for key, value in menu.items():
    print(f"{key:10}: {value:.2f}:")
print("----------------")

while True:
    food = input("select an item(q to quit): ")
    if food == "q":
       break
    elif menu.get(food) is not None:
        cart.append(food)

print("------your order------")
for food in cart:
    total += menu.get(food)
    print(food, end=" ")
print()
print(f"total is {total:.2f}")

    

      